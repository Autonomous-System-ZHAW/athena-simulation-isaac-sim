{
    "name": "${localWorkspaceFolderBasename} ROS2 Dev-Container",
    "privileged": true,
    "remoteUser": "${localEnv:USER}",
    "build": {
        "context": "..",
        "dockerfile": "../.devcontainer/Dockerfile.dockerfile",
        "args": {
            "USERNAME": "${localEnv:USER}",
            "USER_UID": "1000",
            "USER_GID": "1000",
            "WS_BASENAME": "${localWorkspaceFolderBasename}"
        }
    },
    "workspaceFolder": "/home/${localEnv:USER}/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/${localEnv:USER}/ros2_ws/${localWorkspaceFolderBasename},type=bind",
    "customizations": {
        "vscode": {
            "settings": {
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true,
                    "editor.formatOnSaveMode": "file"
                },
                "files.associations": {
                    "*.rviz": "yaml",
                    "*.srdf": "xml",
                    "*.urdf": "xml",
                    "*.xacro": "xml",
                    "*.sdf": "xml",
                    "*.world": "xml",
                    "*.repos": "yaml"
                },
                // Show the imported repos in src/ in the Source Control view
                "git.repositoryScanMaxDepth": 3
            },
            "extensions": [
                "mhutchie.git-graph",
                "ms-azuretools.vscode-docker",
                "ms-python.black-formatter",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-pylance",
                "eamodio.gitlens",
                "ranch-hand-robotics.rde-pack" // replaces the deprecated ms-iot.vscode-ros
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
        "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",

        "ROS_AUTOMATIC_DISCOVERY_RANGE": "SYSTEM_DEFAULT",
        "ROS_DOMAIN_ID": "101",
        "FASTRTPS_DEFAULT_PROFILES_FILE": "/home/${localEnv:USER}/ros2_ws/${localWorkspaceFolderBasename}/.devcontainer/fastdds.xml",
        "RMW_IMPLEMENTATION": "rmw_fastrtps_cpp"
    },
    "runArgs": [
        "--hostname=${localWorkspaceFolderBasename}-devcontainer",
        "--network=host",
        "--ipc=host",
        "--gpus=all",

        // Display access from within the container
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix",
        "-v", "/run/user/1000:/run/user/1000",

        // Vulkan / GXF, needed for composer
        "-v", "/usr/share/vulkan/:/usr/share/vulkan",
        "-v", "/etc/vulkan:/etc/vulkan",
        "-v", "/var/tmp/gxf:/var/tmp/gxf",

        // NFS share
        "-v", "/media/docker-volumes:/mnt"
    ],
    "features": {
        "ghcr.io/devcontainers/features/git": {}
    },
    "postCreateCommand": "bash ${containerWorkspaceFolder}/${localWorkspaceFolderBasename}/.devcontainer/post_create.sh"
}